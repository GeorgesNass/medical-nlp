## ============================================
## General
## ============================================
ENVIRONMENT=dev
LOG_LEVEL=INFO
RANDOM_SEED=42
USE_GPU=false

## ============================================
## Paths
## ============================================
DATA_DIR=./data
RAW_DIR=./data/raw
INTERIM_DIR=./data/interim
PROCESSED_DIR=./data/processed

ARTIFACTS_DIR=./artifacts
LOGS_DIR=./logs
SECRETS_DIR=./secrets
RESOURCES_DIR=./artifacts/resources

## ============================================
## Structured Data Subfolders
## ============================================
INTERIM_STRUCTURED_DIR=./data/interim/lab_structured_csv
INTERIM_DATASETS_DIR=./data/interim/datasets

ARTIFACTS_MODELS_DIR=./artifacts/models
ARTIFACTS_EXPORTS_DIR=./artifacts/exports
ARTIFACTS_EXPORTS_CLUSTERING_DIR=./artifacts/exports/clustering
ARTIFACTS_EXPORTS_EDA_DIR=./artifacts/exports/eda

## ============================================
## MLflow
## ============================================
MLFLOW_TRACKING_URI=./artifacts/mlflow
MLFLOW_EXPERIMENT_NAME=lab_clustering
MLFLOW_AUTO_LOG=false

## ============================================
## Clustering Defaults
## ============================================
DEFAULT_DATASET_FORMAT=wide
DEFAULT_CLUSTERING_ALGORITHM=kmeans
DEFAULT_N_CLUSTERS=3

## ============================================
## Preprocessing Defaults
## ============================================
DEFAULT_IMPUTE_STRATEGY=median
DEFAULT_APPLY_PCA=false
DEFAULT_PCA_N_COMPONENTS=2

## ============================================
## API
## ============================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

## ============================================
## Security
## ============================================
X_API_KEY=<YOUR_X_API_KEY_HERE>