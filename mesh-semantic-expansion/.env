## ============================================
## Application settings
## ============================================
APP_ENV=dev																	## Application environment (dev / staging / prod)
APP_VERSION=1.0.0

## ============================================
## Logging configuration
## ============================================
LOG_LEVEL=INFO									           					## Logging level (DEBUG, INFO, WARNING, ERROR)
LOGS_DIR=logs

## ============================================
## Data directories
## ============================================
DATA_DIR=data
RAW_MESH_DIR=data/raw/mesh
RAW_MEDICAL_DOCS_DIR=data/raw/medical_docs
INTERIM_DIR=data/interim
PROCESSED_DIR=data/processed
OUTPUTS_DIR=data/outputs

## ============================================
## FEATURE ENGINEERING
## ============================================
FEATURE_ENGINEERING_ENABLED=true
TEXT_NORMALIZATION_ENABLED=true
LOWERCASE_ENABLED=true
EMBEDDING_BATCH_SIZE=32
EMBEDDING_NORMALIZE=true
FEATURE_EXPORT_ENABLED=false

## ============================================
## ANOMALY DETECTION
## ============================================
ANOMALY_DETECTION_ENABLED=true
ANOMALY_METHOD=zscore
Z_THRESHOLD=3.0
IQR_MULTIPLIER=1.5
ANOMALY_STRICT_MODE=false

## ============================================
## API and HUGGING FACE secrets
## ============================================
APP_SECRETS_FILE=secrets/app_secrets.json                ## API & HUGGING FACE keys

## ============================================
## MeSH artifacts
## ============================================
MESH_PARSED_FILE=data/interim/mesh_parsed.jsonl
MESH_EMBEDDINGS_FILE=data/interim/mesh_embeddings.parquet
DOC_EMBEDDINGS_FILE=data/interim/doc_embeddings.parquet
MESH_EXTENDED_JSON=data/outputs/mesh_extended.json
REPORT_DIFF_MD=data/outputs/report_diff.md

## ============================================
## Embeddings configuration
## ============================================
EMBEDDING_BACKEND=sentence_transformers                     				## Embedding backend (sentence_transformers | camembert_pooling | fasttext)
ST_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CAMEMBERT_MODEL_NAME=camembert-base

## Path to FastText binary model 
## (required only if EMBEDDING_BACKEND=fasttext)
## Example (Windows): data/raw/fasttext/cc.fr.300.bin
FASTTEXT_MODEL_PATH=
EMB_BATCH_SIZE=64
EMB_MAX_LENGTH=256

EMB_DEVICE=cpu                                                              ## Device for embeddings (cpu or cuda)
EMB_NORMALIZE=0 															## Optional: whether to L2-normalize embeddings (0/1)

## ============================================
## API configuration
## ============================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=1
API_WORKERS=1