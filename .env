## ============================================
## General
## ============================================
LOG_LEVEL=INFO

## ============================================
## Paths
## ============================================
DATA_DIR=./data
RAW_DIR=./data/raw
INTERIM_DIR=./data/interim
PROCESSED_DIR=./data/processed

ARTIFACTS_DIR=./artifacts
LOGS_DIR=./logs

## ============================================
## Security
## ============================================
APP_SECRETS_FILE=secrets/app_secrets.json                 ## API KEY & HUGGING FACE KEY 

## ============================================
## FEATURE ENGINEERING
## ============================================
FEATURE_ENGINEERING_ENABLED=true
TEXT_NORMALIZATION_ENABLED=true
ACCENT_REMOVAL_ENABLED=true
LOWERCASE_ENABLED=true
EMBEDDING_BATCH_SIZE=32
EMBEDDING_NORMALIZE=true
FEATURE_EXPORT_ENABLED=false