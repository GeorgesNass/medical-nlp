## ============================================
## General
## ============================================
LOG_LEVEL=INFO

## ============================================
## GPU / Compute
## ============================================
USE_GPU=auto                                  		## auto | true | false

## ============================================
## Embeddings
## ============================================
EMBEDDING_MODEL=sentence_camembert                  ## sentence_camembert | drbert
EMBEDDING_BATCH_SIZE=32
EMBEDDING_NORMALIZE=true                            ## L2 normalize embeddings

## ============================================
## Segmentation
## ============================================
WINDOW_SIZE_TOKENS=220                              ## Sliding window size (tokens)
WINDOW_OVERLAP_TOKENS=60 
MIN_CHARS_PER_SEGMENT=50

## ============================================
## FEATURE ENGINEERING
## ============================================
FEATURE_ENGINEERING_ENABLED=true
TEXT_NORMALIZATION_ENABLED=true
ACCENT_REMOVAL_ENABLED=true
LOWERCASE_ENABLED=true
FEATURE_EXPORT_ENABLED=false

## ============================================================
## FEATURE STORE
## ============================================================
FEATURE_STORE_MODE=redis
REDIS_HOST=localhost
REDIS_PORT=6379
FEAST_REPO_PATH=./feature_repo

## ============================================
## Similarity / Labeling#
## ============================================
TOP_K=5

THRESH_CRH=0.55
THRESH_CRO=0.55
THRESH_CRA=0.55
THRESH_ORDONNANCE_EXAMEN=0.55
THRESH_ORDONNANCE_MEDICAMENTS=0.55#
THRESH_ANALYSE_LABO=0.55
THRESH_FICHE_PATIENT_ADMISSION=0.55

## ============================================
## Paths
## ============================================
DATA_DIR=./data
LABELED_DIR=./data/labeled
UNLABELED_DIR=./data/unlabeled
INTERIM_DIR=./data/interim
PROCESSED_DIR=./data/processed

ARTIFACTS_DIR=./artifacts
LOGS_DIR=./logs#
